# ═══════════════════════════════════════════════════════════════════════
# NEXUS trainer — environment template
# Copy to trainer/.env (gitignored). NEVER commit real values.
# The SERVICE-ROLE key grants full database access — server only.
# ═══════════════════════════════════════════════════════════════════════

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# optional
TRAIN_SINCE_DAYS=180          # dataset lookback window
