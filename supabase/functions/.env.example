# Local-only template. Hosted Supabase supplies SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY automatically. Never put these in Pages/browser config.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<local-or-staging-service-role-key>
TWELVEDATA_KEYS=<provider-key-one>,<provider-key-two>
NEXUS_ALLOWED_ORIGINS=https://<account>.github.io
# Optional Telegram: omit entirely unless separately authorized.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MAIN_CHAT=
TELEGRAM_PUBLIC_CHAT=
TELEGRAM_VIP_CHAT=
TELEGRAM_LIST_CHAT=
TELEGRAM_ADMIN_CHAT=
NEXUS_TELEGRAM_ADMIN_USER_IDS=
# Scope limits may only lower the account-wide hard caps.
TWELVEDATA_BROWSER_DAILY_CREDIT_LIMIT=700
TWELVEDATA_BROWSER_PER_MINUTE_LIMIT=6
NEXUS_API_USER_RATE_LIMIT_PER_MINUTE=60
NEXUS_TELEGRAM_RATE_LIMIT_PER_MINUTE=30
NEXUS_CLOUD_SYNC_ENABLED=true
NEXUS_CLOUD_MODEL_ENABLED=true
LOG_LEVEL=info
