# ═══════════════════════════════════════════════════════════════════════
# NEXUS server: worker + authenticated HTTP relay
# Copy to server/.env on the host. This file contains placeholders only.
# Never commit .env files or put private values in frontend configuration.
# ═══════════════════════════════════════════════════════════════════════

# ── Supabase (required by worker/relay; service-role key stays server-side) ──
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Twelve Data (required for worker ingestion and browser relay) ──────────
# Comma-separated private keys. They are never sent to the browser.
TWELVEDATA_KEYS=<twelvedata-key-1>,<twelvedata-key-2>

# Browser-relay authoritative budget (separate from the worker budget)
TWELVEDATA_BROWSER_DAILY_CREDIT_LIMIT=700
TWELVEDATA_BROWSER_PER_MINUTE_LIMIT=7

# Worker-authoritative budget — preserve existing safe defaults
TWELVEDATA_DAILY_CREDIT_LIMIT=700
TWELVEDATA_PER_MINUTE_LIMIT=6

# ── Telegram (all bot/chat secrets and destinations stay server-side) ─────
TELEGRAM_BOT_TOKEN=<bot-token>
# Optional: leave all Telegram values unset for the first relay/worker staging check.
# Explicitly configure each destination: missing public/vip/list/admin values fall back to MAIN.
TELEGRAM_MAIN_CHAT=<main-chat-id-or-channel>
TELEGRAM_PUBLIC_CHAT=<public-chat-id-or-channel>
TELEGRAM_VIP_CHAT=<vip-chat-id-or-channel>
TELEGRAM_LIST_CHAT=<list-chat-id-or-channel>
TELEGRAM_ADMIN_CHAT=<private-admin-chat-id>
TELEGRAM_OPS_CHAT=<ops-chat-id-or-channel>
# Supabase Auth user UUIDs permitted to control Telegram; comma-separated.
NEXUS_TELEGRAM_ADMIN_USER_IDS=<admin-auth-user-uuid>

# ── HTTP relay (HTTPS terminates at the hosting proxy) ─────────────────────
# The code reads NEXUS_API_PORT, not a host-provided PORT variable.
NEXUS_API_PORT=8787
# Exact browser origins (scheme + host + optional port, no trailing slash/path) only; never use '*'. Comma-separated.
NEXUS_ALLOWED_ORIGINS=https://<your-pages-site>.github.io
NEXUS_API_USER_RATE_LIMIT_PER_MINUTE=60
NEXUS_TELEGRAM_RATE_LIMIT_PER_MINUTE=30

# ── Worker behaviour ──────────────────────────────────────────────────────
WORKER_POLL_SECONDS=30
INGEST_MIN_INTERVAL_SECONDS=60
INGEST_PAIRS=                     # optional override: EUR/USD,GBP/USD,… (default: all active pairs)
INGEST_OUTPUTSIZE=360             # candles per fetch (max 5000)
EVALUATION_HORIZON_CANDLES=1
EVALUATION_GRACE_SECONDS=120
EVALUATION_MAX_DELAY_MINUTES=30
TELEGRAM_RETRY_MAX=3
ALERT_WINRATE_FLOOR_W20=0.40
ALERT_LOSING_STREAK=5
ALERT_DATA_LAG_SECONDS=180
ALERT_PENDING_EVAL_MINUTES=15
ALERT_FAILED_DELIVERIES=5
RETENTION_DAYS=180
ARCHIVE_BEFORE_PRUNE=false

# Non-secret behavior flags
NEXUS_CLOUD_SYNC_ENABLED=true
NEXUS_CLOUD_MODEL_ENABLED=true

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info                    # debug | info | warn | error
