# ═══════════════════════════════════════════════════════════════════════
# NEXUS server worker — environment template
# Copy to server/.env (gitignored). NEVER commit real values.
# The SERVICE-ROLE key grants full database access — server only.
# ═══════════════════════════════════════════════════════════════════════

# ── Supabase (required) ──────────────────────────────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Market data (required for ingestion) ─────────────────────────────
# Comma-separated Twelve Data keys (rotation + quota cooldown, up to 10)
TWELVEDATA_KEYS=key1,key2

# ── Telegram (required for delivery retries + ops alerts) ────────────
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_OPS_CHAT=<chat-id-or-@channel>

# ── Worker behaviour (optional — sensible defaults) ──────────────────
WORKER_POLL_SECONDS=30            # main loop cadence
INGEST_PAIRS=                     # optional override: EUR/USD,GBP/USD,… (default: all active pairs)
INGEST_OUTPUTSIZE=360             # candles per fetch (max 5000)
EVALUATION_GRACE_SECONDS=120      # wait after a candle closes before evaluating
EVALUATION_MAX_DELAY_MINUTES=30   # older than this → outcome marked invalid
TELEGRAM_RETRY_MAX=3
ALERT_WINRATE_FLOOR_W20=0.40
ALERT_LOSING_STREAK=5
ALERT_DATA_LAG_SECONDS=180
ALERT_PENDING_EVAL_MINUTES=15
ALERT_FAILED_DELIVERIES=5
RETENTION_DAYS=180
ARCHIVE_BEFORE_PRUNE=false

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info                    # debug | info | warn | error
